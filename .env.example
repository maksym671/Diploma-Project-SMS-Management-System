# Copy to .env and fill in values for local/production use.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Database — leave empty to use SQLite locally
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Overrides the published demo password on the "admin" account when the
# seed_demo management command runs. Set this on the hosting platform only.
# DJANGO_ADMIN_PASSWORD=

# Email — password reset
# Local default: console, which prints the message (reset link included)
# straight into the runserver terminal. Nothing is actually sent.
EMAIL_BACKEND=console
DEFAULT_FROM_EMAIL=noreply@sms.example.com

# Real delivery. `manage.py check --deploy` reports which of these is missing,
# and `manage.py sendtestemail you@example.com` proves the settings work.
#
# For Gmail, EMAIL_HOST_PASSWORD must be a 16-character App Password
# (Google account -> Security -> 2-Step Verification -> App passwords),
# not the normal account password. DEFAULT_FROM_EMAIL has to be the address
# that owns the SMTP account or the mail is dropped as spam.
# EMAIL_BACKEND=smtp
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your.account@gmail.com
# EMAIL_HOST_PASSWORD=abcd efgh ijkl mnop
# DEFAULT_FROM_EMAIL=Student Management System <your.account@gmail.com>
