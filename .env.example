# Copy to .env and fill in values for local/production use.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Database — leave empty to use SQLite locally
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Email — password reset
# Local: console (emails printed in terminal)
EMAIL_BACKEND=console
DEFAULT_FROM_EMAIL=noreply@sms.example.com

# Production SMTP example (Gmail / Mailtrap / SendGrid):
# EMAIL_BACKEND=smtp
# EMAIL_HOST=smtp.mailtrap.io
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-username
# EMAIL_HOST_PASSWORD=your-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Student Management System <noreply@yourdomain.com>
